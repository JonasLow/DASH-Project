FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    top
    {
        type            patch;
        nFaces          4;
        startFace       1276;
    }
    bottom
    {
        type            wall;
        inGroups        1(wall);
        nFaces          4;
        startFace       1280;
    }
    inlet
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          320;
        startFace       1284;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  outlet;
    }
    outlet
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          320;
        startFace       1604;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  inlet;
    }
    left
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          320;
        startFace       1924;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  right;
    }
    right
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          320;
        startFace       2244;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  left;
    }
)

