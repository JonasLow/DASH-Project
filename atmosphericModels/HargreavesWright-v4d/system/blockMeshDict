	type patch;
	faces
	(
	    (3 7 6 2)
	);
    }
    ground
    {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }
    top
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    inletSouth
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
    outletEast
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }
);

